# Copia este archivo como .env antes de iniciar el servidor
PORT=3000
JWT_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio

# Envío real de correos (Brevo, vía API HTTPS). Railway bloquea SMTP directo
# en planes Free/Hobby, por eso se usa un servicio con API HTTPS en vez de
# Gmail SMTP. A diferencia de Resend, Brevo no exige dominio propio: basta
# verificar un único correo remitente para poder enviar a cualquier destinatario.
#   1. Crea una cuenta gratis en https://www.brevo.com
#   2. Senders & IP -> Senders -> Add a sender -> pon tu propio correo y
#      confírmalo con el enlace que te llega.
#   3. Settings -> SMTP & API -> API Keys -> Generate a new API key.
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxx
# El correo remitente que verificaste en el paso 2 (debe coincidir exacto).
BREVO_FROM_EMAIL=tuusuario@gmail.com
# Opcional: nombre a mostrar como remitente.
BREVO_FROM_NOMBRE=BarberKing Turnos
