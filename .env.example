# Copia este archivo como .env antes de iniciar el servidor
PORT=3000
JWT_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio

# Envío real de correos (Resend, vía API HTTPS). Railway bloquea SMTP directo
# en planes Free/Hobby, por eso se usa un servicio con API HTTPS en vez de
# Gmail SMTP. Crea una cuenta gratis en https://resend.com y genera una API key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Opcional: remitente con dominio propio verificado en Resend. Si se deja sin
# definir, se usa el remitente de pruebas "onboarding@resend.dev".
RESEND_FROM=BarberKing Turnos <onboarding@resend.dev>
