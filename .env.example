# Copia este archivo como .env antes de iniciar el servidor
PORT=3000
JWT_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio

# Envío real de correos (Gmail SMTP). Genera una "contraseña de aplicación" en
# https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos).
GMAIL_USER=tu-cuenta@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
